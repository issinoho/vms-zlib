--
-- PCSI product description for zlib on OpenVMS.
-- Template: tools/prepare.sh substitutes @PRODUCER@, @BASE@ and @PCSIVERSION@.
--
product @PRODUCER@ @BASE@ ZLIB @PCSIVERSION@ full ;

    information RELEASE_NOTES phase after ;

    directory [ZLIB] ;
    directory [ZLIB.BIN] ;
    directory [ZLIB.DOC] ;
    directory [ZLIB.INCLUDE] ;
    directory [ZLIB.LIB] ;

    file [ZLIB.INCLUDE]ZLIB.H ;
    file [ZLIB.INCLUDE]ZCONF.H ;
    file [ZLIB.LIB]LIBZ.OLB ;
    file [ZLIB.BIN]MINIGZIP.EXE ;
    file [SYS$STARTUP]ZLIB$STARTUP.COM ;
    file [ZLIB.DOC]README.VMS ;
    file [ZLIB.DOC]LICENSE. ;
    file [ZLIB.DOC]README. ;
    file [ZLIB.DOC]CHANGELOG. ;
    file [ZLIB.DOC]ZLIB.TXT ;

    -- Define ZLIB$ROOT now and print the post-installation tasks (PCSI shows
    -- only the title of an information message unless /HELP is given).
    execute postinstall "@PCSI$DESTINATION:[SYS$STARTUP]ZLIB$STARTUP.COM INSTALL" interactive ;
    -- On removal, deassign ZLIB$ROOT.
    execute install "CONTINUE" remove "@PCSI$DESTINATION:[SYS$STARTUP]ZLIB$STARTUP.COM REMOVE" ;

    information POST_INSTALL phase after ;

end product ;
